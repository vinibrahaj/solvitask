<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_solvitask" model="ir.module.category">
            <field name="name">SolviTask</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_solvitask_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="category_id" ref="module_category_solvitask"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_solvitask_plumber" model="res.groups">
            <field name="name">Plumber</field>
            <field name="category_id" ref="module_category_solvitask"/>
            <field name="implied_ids" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <record id="group_solvitask_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_solvitask"/>
            <field name="implied_ids" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

    </data>
</odoo>
