<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
          Record rules answer "WHICH ROWS can this group touch?".
          Rules belonging to different groups are OR'ed together, so the
          Manager rules below (domain [(1,'=',1)] = everything) win for
          anyone who is a manager, even though a manager also inherits the
          restrictive Customer and Plumber rules.

          All of them lean on customer.user_id / plumber.user_id, the new
          link between a SolviTask record and an actual login.
        -->

        <!-- ========== solvitask.customer ========== -->
        <record id="rule_customer_own" model="ir.rule">
            <field name="name">Customer: only my own customer record</field>
            <field name="model_id" ref="model_solvitask_customer"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <record id="rule_customer_plumber" model="ir.rule">
            <field name="name">Plumber: customers of my jobs</field>
            <field name="model_id" ref="model_solvitask_customer"/>
            <field name="domain_force">
                [('job_ids', 'any', [('plumber_ids.user_id', '=', user.id)])]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_customer_manager" model="ir.rule">
            <field name="name">Manager: all customers</field>
            <field name="model_id" ref="model_solvitask_customer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

        <!-- ========== solvitask.plumber ========== -->
        <!-- A customer may read the plumbers working on one of HIS jobs, and
             only while that job is still live. From Ready to Invoice onwards
             the job drops out of the domain and the plumber becomes
             invisible to him again. -->
        <record id="rule_plumber_customer" model="ir.rule">
            <field name="name">Customer: plumbers on my live jobs</field>
            <field name="model_id" ref="model_solvitask_plumber"/>
            <field name="domain_force">
                [('job_ids', 'any',
                    ['&amp;',
                     ('customer_id.user_id', '=', user.id),
                     ('stage_id', 'in', ['stage_new', 'stage_scheduled',
                                         'stage_in_progress'])])]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <record id="rule_plumber_own" model="ir.rule">
            <field name="name">Plumber: myself and my co-workers</field>
            <field name="model_id" ref="model_solvitask_plumber"/>
            <field name="domain_force">
                ['|',
                 ('user_id', '=', user.id),
                 ('job_ids', 'any', [('plumber_ids.user_id', '=', user.id)])]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_plumber_manager" model="ir.rule">
            <field name="name">Manager: all plumbers</field>
            <field name="model_id" ref="model_solvitask_plumber"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

        <!-- ========== solvitask.plumber.slot ========== -->
        <record id="rule_slot_own" model="ir.rule">
            <field name="name">Plumber: my own availability</field>
            <field name="model_id" ref="model_solvitask_plumber_slot"/>
            <field name="domain_force">[('plumber_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_slot_manager" model="ir.rule">
            <field name="name">Manager: all availability</field>
            <field name="model_id" ref="model_solvitask_plumber_slot"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

        <!-- ========== solvitask.job ========== -->
        <record id="rule_job_customer" model="ir.rule">
            <field name="name">Customer: only my own jobs</field>
            <field name="model_id" ref="model_solvitask_job"/>
            <field name="domain_force">[('customer_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <record id="rule_job_plumber" model="ir.rule">
            <field name="name">Plumber: jobs I am assigned to</field>
            <field name="model_id" ref="model_solvitask_job"/>
            <field name="domain_force">[('plumber_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_job_manager" model="ir.rule">
            <field name="name">Manager: all jobs</field>
            <field name="model_id" ref="model_solvitask_job"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

        <!-- ========== solvitask.job.material ========== -->
        <record id="rule_job_material_customer" model="ir.rule">
            <field name="name">Customer: material lines of my jobs</field>
            <field name="model_id" ref="model_solvitask_job_material"/>
            <field name="domain_force">
                [('job_id.customer_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <record id="rule_job_material_plumber" model="ir.rule">
            <field name="name">Plumber: material lines of my jobs</field>
            <field name="model_id" ref="model_solvitask_job_material"/>
            <field name="domain_force">
                [('job_id.plumber_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_job_material_manager" model="ir.rule">
            <field name="name">Manager: all material lines</field>
            <field name="model_id" ref="model_solvitask_job_material"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

        <!-- ========== solvitask.requests ========== -->
        <!-- The customer sees the requests HE raised. -->
        <record id="rule_requests_customer" model="ir.rule">
            <field name="name">Customer: only my own requests</field>
            <field name="model_id" ref="model_solvitask_requests"/>
            <field name="domain_force">[('customer_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_solvitask_customer'))]"/>
        </record>

        <!-- The plumber sees EVERY request on a job he is assigned to,
             whoever raised it. -->
        <record id="rule_requests_plumber" model="ir.rule">
            <field name="name">Plumber: all requests on my jobs</field>
            <field name="model_id" ref="model_solvitask_requests"/>
            <field name="domain_force">
                [('job_id.plumber_ids.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_plumber'))]"/>
        </record>

        <record id="rule_requests_manager" model="ir.rule">
            <field name="name">Manager: all requests</field>
            <field name="model_id" ref="model_solvitask_requests"/>
            <field name="domain_force">
                ['|', ('state', '!=', 'draft'), ('requester_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_solvitask_manager'))]"/>
        </record>

    </data>
</odoo>
