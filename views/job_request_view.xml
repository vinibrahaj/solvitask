<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="job_request_form_view" model="ir.ui.view">
            <field name="name">solvitask.job.request.form</field>
            <field name="model">solvitask.job.request</field>
            <field name="arch" type="xml">
                <form string="Job Change Request">
                    <header>
                        <button name="action_approve" string="Approve"
                                type="object" class="oe_highlight"
                                invisible="state != 'draft'"/>
                        <button name="action_reject" string="Reject"
                                type="object"
                                invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="job_id"/>
                            <field name="request_type"/>
                            <field name="requested_by"/>
                            <field name="new_scheduled_date"
                                   invisible="request_type != 'reschedule'"/>
                            <field name="new_address"
                                   invisible="request_type != 'address'"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="job_request_tree_view" model="ir.ui.view">
            <field name="name">solvitask.job.request.tree</field>
            <field name="model">solvitask.job.request</field>
            <field name="arch" type="xml">
                <tree string="Job Change Requests">
                    <field name="job_id"/>
                    <field name="request_type"/>
                    <field name="requested_by"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="job_request_act_window" model="ir.actions.act_window">
            <field name="name">Change Requests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.job.request</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Change Requests" id="job_request_menu" parent="solvitask_root"
                  action="job_request_act_window" sequence="6"/>

    </data>
</odoo>
