<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="worker_form_view" model="ir.ui.view">
            <field name="name">solvitask.worker.form</field>
            <field name="model">solvitask.worker</field>
            <field name="arch" type="xml">
                <form string="Worker">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="Name"/>
                                <field name="surname" placeholder="Surname"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Contact">
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="address"/>
                            </group>
                            <group string="Work">
                                <field name="available"/>
                                <field name="hourly_rate"/>
                                <field name="payment_method"/>
                            </group>
                            <group string="Activity">
                                <field name="job_ids"/>
                                <field name="request_ids"/>
                            </group>
                        </group>
                        <group string="Skills">
                            <field name="service_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="worker_tree_view" model="ir.ui.view">
            <field name="name">solvitask.worker.tree</field>
            <field name="model">solvitask.worker</field>
            <field name="arch" type="xml">
                <tree string="Worker">
                    <field name="name"/>
                    <field name="surname"/>
                    <field name="phone"/>
                    <field name="available"/>
                    <field name="hourly_rate"/>
                </tree>
            </field>
        </record>

        <record id="worker_search_view" model="ir.ui.view">
            <field name="name">solvitask.worker.search</field>
            <field name="model">solvitask.worker</field>
            <field name="arch" type="xml">
                <search string="Worker">
                    <field name="name"/>
                    <field name="surname"/>
                    <filter string="Available" name="filter_available"
                            domain="[('available', '=', True)]"/>
                </search>
            </field>
        </record>

        <record id="worker_act_window" model="ir.actions.act_window">
            <field name="name">Workers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.worker</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem name="Workers" id="worker_menu" parent="solvitask_root"
                  action="worker_act_window" sequence="20"/>

    </data>
</odoo>
