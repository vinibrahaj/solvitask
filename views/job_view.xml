<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==== RULE 4: drag-and-drop board, grouped by stage_id ==== -->
        <record id="job_kanban_view" model="ir.ui.view">
            <field name="name">solvitask.job.kanban</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <kanban default_group_by="stage_id" class="o_kanban_small_column"
                        group_create="false" group_edit="false" groups_draggable="false"
                        records_draggable="true">
                    <field name="stage_id"/>
                    <field name="worker_ids"/>
                    <field name="is_cancelled">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div><field name="customer_id"/></div>
                                    <div t-if="record.worker_ids.raw_value">
                                        <i class="fa fa-user" role="img"/>
                                        <field name="worker_ids"/>
                                    </div>
                                    <div><field name="total_price"/></div>
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="job_form_view" model="ir.ui.view">
            <field name="name">solvitask.job.form</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <form string="Job">
                    <header>
                        <!-- RULE 3: only shown once the stage is a "finished" one -->
                        <button name="action_mark_started" string="Mark as Started"
                                type="object" class="oe_highlight"
                                invisible="stage_is_started or is_cancelled"/>
                        <button name="action_generate_invoice"
                                string="Generate &amp; Send Invoice"
                                type="object" class="oe_highlight"
                                invisible="not stage_is_done"/>
                        <button name="action_cancel" string="Cancel Job"
                                type="object"
                                invisible="is_cancelled"
                                confirm="Cancel this job? If work has already started, only a manager can do this."/>
                        <!-- clickable status bar; moving here writes stage_id,
                             so RULE 1 &amp; 2 constraint applies to it too -->
                        <field name="stage_id" widget="statusbar"
                               options="{'clickable': '1'}"
                               statusbar_visible="stage_new,stage_scheduled,stage_in_progress,stage_ready_invoice,stage_invoiced,stage_paid"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Canceled"
                                bg_color="text-bg-danger"
                                invisible="not is_cancelled"/>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_requests"
                                    class="oe_stat_button" icon="fa-comments-o">
                                <field name="request_count" widget="statinfo"
                                       string="Requests"/>
                            </button>
                        </div>
                        <field name="stage_is_done" invisible="1"/>
                        <field name="stage_is_started" invisible="1"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <field name="is_cancelled"/>
                        <group>
                            <group string="Request">
                                <field name="customer_id"/>
                                <field name="is_custom"/>
                                <field name="service_id" invisible="is_custom"/>
                                <field name="priority"/>
                                <field name="description" required="is_custom"
                                       placeholder="Describe the problem"/>
                                <field name="problem_photo" widget="image"/>
                                <field name="service_address"/>
                            </group>
                            <group string="Assignment">
                                <field name="worker_ids"/>
                                <field name="scheduled_date"/>
                                <field name="tool_ids" widget="many2many_tags"/>
                                <field name="last_request_update" readonly="1"
                                       invisible="not last_request_update"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Work Done">
                                <field name="material_line_ids">
                                    <tree editable="bottom">
                                        <field name="material_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer">
                                    <field name="initial_price"/>
                                    <field name="hours_worked"/>
                                    <field name="labor_cost"/>
                                    <field name="material_cost"/>
                                    <field name="total_price"/>
                                </group>
                                <field name="work_notes"
                                       placeholder="What was found and fixed..."/>
                            </page>
                            <page string="Requests">
                                <field name="request_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="request_type"/>
                                        <field name="source"/>
                                        <field name="description"/>
                                        <field name="manager_note"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="job_tree_view" model="ir.ui.view">
            <field name="name">solvitask.job.tree</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <tree string="Job">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="is_custom" widget="boolean_toggle"/>
                    <field name="worker_ids"/>
                    <field name="priority"/>
                    <field name="scheduled_date"/>
                    <field name="stage_id"/>
                    <field name="total_price" sum="Total"/>
                </tree>
            </field>
        </record>

        <record id="job_search_view" model="ir.ui.view">
            <field name="name">solvitask.job.search</field>
            <field name="model">solvitask.job</field>
            <field name="arch" type="xml">
                <search string="Job">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="worker_ids"/>
                    <filter string="Custom requests" name="filter_custom"
                            domain="[('is_custom', '=', True)]"/>
                    <filter string="Listed services" name="filter_listed"
                            domain="[('is_custom', '=', False)]"/>
                    <separator/>
                    <filter string="Unassigned" name="filter_unassigned"
                            domain="[('worker_ids', '=', False)]"/>
                    <filter string="Emergency" name="filter_emergency"
                            domain="[('priority', '=', 'emergency')]"/>
                    <separator/>
                    <filter string="Open jobs" name="filter_open"
                            domain="[('stage_id', 'not in',
                                      ['stage_paid', 'stage_canceled'])]"/>
                    <filter string="Canceled" name="filter_canceled"
                            domain="[('stage_id', '=', 'stage_canceled')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Stage" name="group_by_stage"
                                context="{'group_by': 'stage_id'}"/>
                        <filter string="Plumber" name="group_by_worker"
                                context="{'group_by': 'worker_ids'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="job_act_window" model="ir.actions.act_window">
            <field name="name">Jobs</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">solvitask.job</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <menuitem name="Jobs" id="job_menu" parent="solvitask_root"
                  action="job_act_window" sequence="5"/>

    </data>
</odoo>
