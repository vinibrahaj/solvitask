<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": created once, then left alone so your edits survive upgrades. -->
    <data noupdate="1">

        <record id="stage_new" model="solvitask.job.stage">
            <field name="name">New Request</field>
            <field name="sequence">10</field>
        </record>

        <record id="stage_scheduled" model="solvitask.job.stage">
            <field name="name">Scheduled</field>
            <field name="sequence">20</field>
        </record>

        <record id="stage_in_progress" model="solvitask.job.stage">
            <field name="name">In Progress</field>
            <field name="sequence">30</field>
            <field name="is_started">1</field>
        </record>

        <record id="stage_waiting" model="solvitask.job.stage">
            <field name="name">Waiting for Parts</field>
            <field name="sequence">40</field>
            <field name="is_started">1</field>
        </record>

        <record id="stage_completed" model="solvitask.job.stage">
            <field name="name">Completed</field>
            <field name="sequence">50</field>
            <field name="is_started">1</field>
            <field name="is_done">1</field>
        </record>

        <record id="stage_invoiced" model="solvitask.job.stage">
            <field name="name">Invoiced</field>
            <field name="sequence">60</field>
            <field name="is_started">1</field>
            <field name="is_done">1</field>
            <field name="fold">1</field>
        </record>

        <record id="stage_paid" model="solvitask.job.stage">
            <field name="name">Paid</field>
            <field name="sequence">70</field>
            <field name="is_started">1</field>
            <field name="is_done">1</field>
            <field name="fold">1</field>
        </record>

    </data>
</odoo>
